# TerraTokenX — Variables de Entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA commitear el .env real al repositorio.
# Para pasar valores al Dev Asociado: canal seguro (no WhatsApp, no Slack público).

# ══════════════════════════════════════════════
# DJANGO CORE
# ══════════════════════════════════════════════
DJANGO_ENV=local                          # local | staging | production
SECRET_KEY=django-insecure-REEMPLAZAR     # Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=True                                # False en producción SIEMPRE
ALLOWED_HOSTS=localhost,127.0.0.1         # En prod: terratokenx.com,www.terratokenx.com

# ══════════════════════════════════════════════
# BASE DE DATOS (PostgreSQL en Render)
# ══════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host:5432/terratokenx
# En local puedes usar: postgresql://postgres:postgres@localhost:5432/terratokenx_dev

# ══════════════════════════════════════════════
# REDIS (Render Redis add-on)
# ══════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0
# En producción Render te da la URL completa con credenciales

# ══════════════════════════════════════════════
# CORS (Separar con comas si hay varios)
# ══════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# En prod: https://terratokenx.com,https://www.terratokenx.com

# ══════════════════════════════════════════════
# ── FASE 0 / FASE 1 ──────────────────────────
# ══════════════════════════════════════════════

# MERCADOPAGO
# Obtener en: https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REEMPLAZAR
MERCADOPAGO_PUBLIC_KEY=APP_USR-REEMPLAZAR
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZAR     # Generado al configurar webhook en MP

# CRYPTOMUS
# Obtener en: https://app.cryptomus.com/merchants → API Keys
CRYPTOMUS_MERCHANT_ID=REEMPLAZAR
CRYPTOMUS_PAYMENT_API_KEY=REEMPLAZAR
CRYPTOMUS_PAYOUT_API_KEY=REEMPLAZAR       # Solo si usas payouts

# KUSHKI
# Obtener en: https://dashboard.kushkipagos.com → Credenciales
KUSHKI_PUBLIC_KEY=REEMPLAZAR
KUSHKI_PRIVATE_KEY=REEMPLAZAR
KUSHKI_ENV=sandbox                         # sandbox | production

# DIDIT (KYC / AML / Wallet Screening)
# Obtener en: https://dashboard.didit.me → Settings → API Keys
# 500 verificaciones gratis/mes. No requiere tarjeta para empezar.
DIDIT_API_KEY=REEMPLAZAR
DIDIT_WEBHOOK_URL=https://TU-DOMINIO/api/webhooks/didit/
DIDIT_WEBHOOK_SECRET=REEMPLAZAR           # Se genera al crear el webhook en Didit

# FLOID (Registro Civil Chile — solo para usuarios chilenos)
# Obtener en: https://floid.io → Contactar para API key
FLOID_API_KEY=REEMPLAZAR

# RESEND (Email transaccional — reemplaza SendGrid)
# Obtener en: https://resend.com → API Keys
# Free tier: 3.000 emails/mes permanente
RESEND_API_KEY=re_REEMPLAZAR
EMAIL_FROM=noreply@terratokenx.com        # Debe estar verificado en Resend

# CLOUDFLARE R2 (Storage de archivos — S3-compatible)
# Obtener en: https://dash.cloudflare.com → R2 → Manage R2 API tokens
R2_ACCESS_KEY_ID=REEMPLAZAR
R2_SECRET_ACCESS_KEY=REEMPLAZAR
R2_BUCKET_NAME=terratokenx-files
R2_ENDPOINT_URL=https://TU-ACCOUNT-ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://files.terratokenx.com  # Si tienes dominio custom en R2

# SENTRY (Error tracking en producción)
# Obtener en: https://sentry.io → Projects → DSN
SENTRY_DSN=https://REEMPLAZAR@sentry.io/REEMPLAZAR

# ══════════════════════════════════════════════
# ── FASE 2 (Frontend) — agregar cuando corresponda
# ══════════════════════════════════════════════
# COINGECKO (Precios crypto — free tier, sin clave)
# Sin variable necesaria para el free tier público
# Con cuenta Demo: COINGECKO_API_KEY=CG-REEMPLAZAR

# FRANKFURTER (Conversión USD/CLP — gratis, sin clave)
# Sin variable necesaria. Endpoint público: https://api.frankfurter.dev

# ══════════════════════════════════════════════
# ── FASE 3 (Blockchain Polygon) — NO configurar hasta semana 12
# ══════════════════════════════════════════════

# ALCHEMY (RPC Polygon)
# Obtener en: https://dashboard.alchemy.com → Create App → Polygon
# POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/TU-API-KEY
# POLYGON_RPC_TESTNET=https://polygon-amoy.g.alchemy.com/v2/TU-API-KEY

# WALLET BACKEND (la wallet que firma transacciones en Django)
# ⚠️  SECRETO MÁS SENSIBLE DEL PROYECTO. Nunca compartir. Nunca al repo.
# ⚠️  Si se filtra: alguien vacía el wallet de gas y puede comprometer contratos.
# BACKEND_WALLET_ADDRESS=0x...
# BACKEND_WALLET_PRIVATE_KEY=0x...

# CONTRATOS ERC-3643 (se obtienen DESPUÉS del deploy en semana 12/16)
# TOKEN_CONTRACT_ADDRESS=0x...
# IDENTITY_REGISTRY_ADDRESS=0x...
# COMPLIANCE_ADDRESS=0x...
# TREX_FACTORY_ADDRESS=0x...

# POLYGONSCAN (verificar TX — free tier suficiente)
# Obtener en: https://polygonscan.com/myapikey
# POLYGONSCAN_API_KEY=REEMPLAZAR

# ══════════════════════════════════════════════
# ── OPCIONALES
# ══════════════════════════════════════════════

# TWILIO VERIFY (SMS OTP para T1 Bronze — opcional en MVP)
# Obtener en: https://console.twilio.com
# TWILIO_ACCOUNT_SID=REEMPLAZAR
# TWILIO_AUTH_TOKEN=REEMPLAZAR
# TWILIO_VERIFY_SERVICE_SID=REEMPLAZAR
